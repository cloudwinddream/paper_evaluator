# ============================================
# 论文评审系统 - 环境变量配置模板
# ============================================
# 复制此文件为 .env 并填入实际值

# OpenAI兼容API配置
API_BASE_URL=https://your-api-endpoint.com/v1
API_KEY=your-api-key-here
API_MODEL=your-model-name

# 学生论文文件夹路径（绝对路径或相对路径）
PAPERS_DIR=./学生论文

# 题目要求Word文档路径（绝对路径或相对路径）
REQUIREMENTS_DOC=./config/题目要求.docx

# 报告输出目录
OUTPUT_DIR=./outputs
