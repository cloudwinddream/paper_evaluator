# ============================================
# 论文评审系统 - 环境变量配置模板
# ============================================
# 复制此文件为 .env 并填入实际值

# ---- 第一 API Provider（必填） ----
API_BASE_URL=https://api.longcat.chat/openai/v1
API_KEY=your-api-key-here
API_MODEL=gpt-4o-mini

# ---- 第二 API Provider（可选，故障/限流时自动切换） ----
API_BASE_URL_2=https://api.openai.com/v1
API_KEY_2=sk-your-second-key
API_MODEL_2=gpt-4o-mini

# ---- 第三、四、五……以此类推（可选） ----
# API_BASE_URL_3=...
# API_KEY_3=...
# API_MODEL_3=...

# 学生论文文件夹路径（绝对路径或相对路径）
PAPERS_DIR=./学生论文

# 题目要求Word文档路径（绝对路径或相对路径）
REQUIREMENTS_DOC=./config/题目要求.docx

# 报告输出目录
OUTPUT_DIR=./outputs

# ---- 后处理归一化（可选，GUI 保存用） ----
# OUTPUT_MIN=60
# OUTPUT_MAX=90
# OUTPUT_EXPONENT=1.5
